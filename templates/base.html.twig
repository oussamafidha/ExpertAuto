<!doctype html>
<html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Expert Auto Plus{% endblock %}</title>
<link rel="icon" href="{{ asset('favicon.ico') }}" sizes="any">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
body{background:#f4f6fa;color:#182230}.app-layout{display:flex;flex-wrap:nowrap;min-height:100vh}.sidebar{background:#162943;color:#fff;display:flex;flex:0 0 320px;flex-direction:column;height:100vh;min-height:100vh;overflow-y:auto;padding:1.25rem!important;position:sticky;top:0;transition:flex-basis .2s ease}.sidebar a{border-radius:.55rem;color:#dce6f5;display:block;padding:.72rem .8rem;text-decoration:none}.sidebar a:hover{background:#294665;color:#fff}.brand{align-items:center;display:flex;gap:1rem;justify-content:space-between;padding:.5rem 0 1.5rem;position:relative}.brand-logo{border-radius:50%;display:block;flex:0 1 50%;height:auto;margin-inline:auto;max-width:50%}.sidebar-toggle{color:#dce6f5;border:1px solid #59708a;flex:none}.brand>.sidebar-toggle{position:absolute;right:0}.sidebar-toggle:hover{color:#fff;background:#294665}.sidebar nav a{margin-bottom:.45rem}.sidebar-footer{margin-top:auto;padding-top:1rem}.sidebar-user{color:#91a7c2;font-size:.95rem;line-height:1.65;margin-bottom:1rem}.sidebar-logout{margin-bottom:1.5rem}.sidebar-collapsed{flex-basis:88px}.sidebar-collapsed .sidebar-label,.sidebar-collapsed .sidebar-user{display:none!important}.sidebar-collapsed a{text-align:center}.sidebar-collapsed .brand{flex-direction:column;gap:.75rem}.sidebar-collapsed .brand-logo{flex:0 1 50%;max-width:50%}.sidebar-collapsed .brand>.sidebar-toggle{position:static;width:100%}.main-content{min-width:0}.dashboard-logo{display:block;width:88px;height:88px;object-fit:cover;border-radius:50%}.card{border:0;border-radius:1rem;box-shadow:0 4px 20px #1822300b}.form-control,.form-select{padding:.68rem;border-radius:.65rem}.btn{border-radius:.6rem}.table thead th{font-size:.82rem;color:#667085}.dashboard-panel{overflow:hidden}.dashboard-panel--waiting{border-top:3px solid #f0ad4e}.dashboard-panel--ongoing{border-top:3px solid #3b82f6}.dashboard-panel--completed{border-top:3px solid #28a879}.dashboard-table{width:100%;min-width:0;table-layout:fixed}.dashboard-table th,.dashboard-table td{font-size:.88rem;overflow-wrap:anywhere;white-space:normal}
@media(max-width:767.98px){.app-layout{flex-direction:column}.sidebar,.sidebar-collapsed{flex-basis:auto;height:auto;min-height:0;position:relative;width:100%}.sidebar .brand{padding-bottom:.5rem}.sidebar-collapsed #sidebarNavigation,.sidebar-collapsed .sidebar-footer{display:none!important}.sidebar-collapsed .brand{flex-direction:row}.sidebar-collapsed .brand-logo{flex-basis:50%;max-width:50%}.sidebar-collapsed .sidebar-toggle{width:auto}.main-content{width:100%}}
</style></head><body>
<div class="container-fluid"><div class="app-layout">
{% if app.user %}<aside id="sidebar" class="sidebar"><div class="brand"><img class="brand-logo" src="{{ asset('images/expert-auto-logo.png') }}" alt="Expert Auto — Agent de Professionnels de l’Automobile"><button id="sidebarToggle" class="btn btn-sm sidebar-toggle" type="button" aria-label="Réduire le menu" aria-expanded="true" aria-controls="sidebarNavigation">☰</button></div>
<nav id="sidebarNavigation"><a href="{{ path('app_dashboard') }}">▦ <span class="sidebar-label">Tableau de bord</span></a><a href="{{ path('vehicle_index') }}">🚘 <span class="sidebar-label">Voitures</span></a><a href="{{ path('appointment_index') }}">📅 <span class="sidebar-label">Rendez-vous</span></a><a href="{{ path('repair_index') }}">🛠 <span class="sidebar-label">Réparations</span></a><a href="{{ path('part_index') }}">⚙ <span class="sidebar-label">Pièces détachées</span></a><a href="{{ path('invoice_index') }}">🧾 <span class="sidebar-label">Factures</span></a></nav>
<div class="sidebar-footer"><div class="sidebar-user">{{ app.user.fullName }}<br>{{ app.user.userIdentifier }}</div><a class="sidebar-logout" href="{{ path('app_logout') }}">↪ <span class="sidebar-label">Déconnexion</span></a></div></aside>{% endif %}
<main id="mainContent" class="main-content flex-grow-1 p-4 p-lg-5">
{% for msg in app.flashes('success') %}<div class="alert alert-success">{{ msg }}</div>{% endfor %}{% for msg in app.flashes('error') %}<div class="alert alert-danger">{{ msg }}</div>{% endfor %}
{% block body %}{% endblock %}</main></div></div>
{% block javascripts %}
    {% if app.user %}
        <script>
            document.getElementById('sidebarToggle').addEventListener('click', function () {
                const sidebar = document.getElementById('sidebar');
                const collapsed = sidebar.classList.toggle('sidebar-collapsed');

                this.setAttribute('aria-expanded', String(!collapsed));
                this.setAttribute('aria-label', collapsed ? 'Ouvrir le menu' : 'Réduire le menu');
            });
        </script>
    {% endif %}
{% endblock %}
</body></html>
