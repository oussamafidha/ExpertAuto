{% extends 'base.html.twig' %}{% block title %}Créer l'administrateur{% endblock %}{% block body %}
<div class="row justify-content-center mt-4"><div class="col-md-6"><div class="card p-4"><h1 class="h3 fw-bold">Créer le premier administrateur</h1><p class="text-secondary">Cette page n'est disponible que tant qu'aucun utilisateur n'existe. Supprimez-la ou désactivez-la après la création du compte.</p>{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
<form method="post"><label class="form-label">Nom complet</label><input class="form-control mb-3" name="fullName" required><label class="form-label">E-mail</label><input class="form-control mb-3" name="email" type="email" required><label class="form-label">Mot de passe (12 caractères minimum)</label><input class="form-control mb-3" name="password" type="password" minlength="12" required><button class="btn btn-primary">Créer l'administrateur</button></form></div></div></div>{% endblock %}
