<div class="dashboard-heading d-flex justify-content-between flex-wrap gap-3 align-items-end mb-4">
    <div>
        <p class="text-uppercase text-secondary small fw-semibold mb-1">Date et heure maintenant</p>
        <h1 class="h2 fw-bold mb-0">{{ 'now'|date('d/m/Y · H:i') }}</h1>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-3">
        {% if app.user %}
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-primary" href="{{ path('appointment_new') }}">＋ Nouveau rendez-vous</a>
                <a class="btn btn-primary" href="{{ path('repair_new') }}">＋ Nouvelle réparation</a>
            </div>
        {% endif %}
        <a href="{{ path('app_login') }}" aria-label="Se connecter">
            <img class="dashboard-logo" src="{{ asset('images/logo.png') }}" alt="Logo Le professionnel des automobiles">
        </a>
    </div>
</div>

<div class="row g-3 align-items-stretch">
    {% set columns = [
        {
            title: 'Voitures en attente',
            repairs: waitingRepairs,
            tone: 'waiting',
            empty: 'Aucune voiture en attente.',
            columnCount: 6
        },
        {
            title: 'Voitures réparées',
            repairs: completedRepairs,
            tone: 'completed',
            empty: 'Aucune réparation terminée.',
            columnCount: 4
        }
    ] %}

    {% for column in columns %}
        <div class="{{ column.tone == 'waiting' ? 'col-12 col-xl-8' : 'col-12 col-xl-4' }}">
            <section class="card dashboard-panel dashboard-panel--{{ column.tone }} dashboard-top-panel h-100">
                <div class="d-flex justify-content-between align-items-center p-3 p-xl-4 pb-2">
                    <h2 class="h5 fw-bold mb-0">{{ column.title }}</h2>
                    <span class="badge rounded-pill text-bg-light border">{{ column.repairs|length }}</span>
                </div>
                <div class="table-responsive px-3 px-xl-4 pb-3">
                    <table class="table dashboard-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="dashboard-number-column">N°</th>
                                <th>Voiture</th>
                                <th>Réparation</th>
                                <th>Réparateur</th>
                                {% if column.tone == 'waiting' %}
                                    <th>Date d'ajout</th>
                                    <th>Heure début estimée</th>
                                {% endif %}
                            </tr>
                        </thead>
                        <tbody data-rotation-page-size="3" data-empty-message="{{ column.empty }}" data-column-count="{{ column.columnCount }}">
                            {% for repair in column.repairs %}
                                <tr class="dashboard-repair-row" data-href="{{ path('repair_show', {id: repair.id}) }}" role="link" tabindex="0" aria-label="Consulter la réparation {{ repair.title }} pour {{ repair.vehicle.registrationNumber }}">
                                    <td class="dashboard-number-column">{{ loop.index }}</td>
                                    <td>
                                        <span class="d-block fw-semibold">{{ repair.vehicle.registrationNumber }}</span>
                                        <span class="small text-secondary">{{ repair.vehicle.make }} {{ repair.vehicle.model }}</span>
                                    </td>
                                    <td>{{ repair.title }}</td>
                                    <td>{{ repair.mechanic ? repair.mechanic.fullName : 'Non affecté' }}</td>
                                    {% if column.tone == 'waiting' %}
                                        {% set plannedStart = plannedStartByVehicle[repair.vehicle.id]|default(null) %}
                                        <td>{{ repair.openedAt|date('d/m/Y à H:i') }}</td>
                                        <td>{{ plannedStart ? plannedStart|date('d/m/Y à H:i') : 'Non planifié' }}</td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    {% endfor %}

    <div class="col-12">
        <section class="card dashboard-panel dashboard-panel--ongoing dashboard-ongoing-panel">
            <div class="d-flex justify-content-between align-items-center p-3 p-xl-4 pb-2">
                <h2 class="h5 fw-bold mb-0">Voitures en réparation</h2>
                <span class="badge rounded-pill text-bg-light border">{{ ongoingRepairs|length }}</span>
            </div>
            <div class="table-responsive px-3 px-xl-4 pb-3">
                <table class="table dashboard-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="dashboard-number-column">N°</th>
                            <th>Voiture</th>
                            <th>Réparation</th>
                            <th>Réparateur</th>
                            <th>Début</th>
                            <th>Fin</th>
                        </tr>
                    </thead>
                    <tbody data-rotation-page-size="3" data-empty-message="Aucune réparation en cours." data-column-count="6">
                        {% for repair in ongoingRepairs %}
                            <tr class="dashboard-repair-row" data-href="{{ path('repair_show', {id: repair.id}) }}" role="link" tabindex="0" aria-label="Consulter la réparation {{ repair.title }} pour {{ repair.vehicle.registrationNumber }}">
                                <td class="dashboard-number-column">{{ loop.index }}</td>
                                <td>
                                    <span class="d-block fw-semibold">{{ repair.vehicle.registrationNumber }}</span>
                                    <span class="small text-secondary">{{ repair.vehicle.make }} {{ repair.vehicle.model }}</span>
                                </td>
                                <td>{{ repair.title }}</td>
                                <td>{{ repair.mechanic ? repair.mechanic.fullName : 'Non affecté' }}</td>
                                <td>{{ repair.openedAt|date('d/m/Y') }}</td>
                                <td>{{ repair.closedAt ? repair.closedAt|date('d/m/Y') : '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
