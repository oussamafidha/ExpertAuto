{% extends 'base.html.twig' %}{% block title %}Factures{% endblock %}{% block body %}<div class="d-flex justify-content-between mb-4"><h1 class="h2 fw-bold">Factures</h1><a class="btn btn-primary" href="{{ path('invoice_new') }}">＋ Nouvelle facture</a></div><div class="card p-4 table-responsive"><table class="table align-middle"><thead><tr><th>N° facture</th><th>Date</th><th>Voiture / client</th><th>Statut</th><th>Total TTC</th></tr></thead><tbody>{% for i in items %}<tr><td>{{ i.number }}</td><td>{{ i.issuedAt|date('d/m/Y') }}</td><td>{{ i.vehicle.registrationNumber }} — {{ i.vehicle.ownerName }}</td><td>{{ i.status }}</td><td>{{ i.total|number_format(2, ',', ' ') }} DT</td></tr>{% else %}<tr><td colspan="5">Aucune facture.</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
