{% extends 'base.html.twig' %}{% block title %}Voitures{% endblock %}{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2 fw-bold">Gestion des voitures</h1><p class="text-secondary">Clients et immatriculations</p></div><a class="btn btn-primary" href="{{ path('vehicle_new') }}">＋ Ajouter</a></div>
<div class="card p-4"><form class="row g-2 mb-3"><div class="col-md-8"><input class="form-control" name="q" value="{{ q }}" placeholder="Immatriculation, marque, modèle, client"></div><div class="col-auto"><button class="btn btn-outline-primary">Rechercher</button></div></form><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Immatriculation</th><th>Voiture</th><th>Client</th><th>Téléphone</th><th></th></tr></thead><tbody>{% for v in items %}<tr><td>{{ v.registrationNumber }}</td><td>{{ v.make }} {{ v.model }}</td><td>{{ v.ownerName }}</td><td>{{ v.ownerPhone ?: '—' }}</td><td><a class="btn btn-sm btn-outline-primary" href="{{ path('vehicle_show',{id:v.id}) }}">Consulter</a></td></tr>{% else %}<tr><td colspan="5">Aucune voiture enregistrée.</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}
