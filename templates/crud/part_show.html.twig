{% extends 'base.html.twig' %}

{% block title %}Pièce — {{ item.reference }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <h1 class="h2 fw-bold mb-0">Fiche pièce détachée</h1>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="{{ path('part_index') }}">Retour aux pièces</a>
            {% if is_granted('ROLE_MECHANIC') %}
                <a class="btn btn-primary" href="{{ path('part_edit', {id: item.id}) }}">Modifier</a>
            {% endif %}
        </div>
    </div>
    <div class="card p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4">Référence</dt><dd class="col-sm-8">{{ item.reference }}</dd>
            <dt class="col-sm-4">Nom</dt><dd class="col-sm-8">{{ item.name }}</dd>
            <dt class="col-sm-4">Quantité en stock</dt><dd class="col-sm-8">{{ item.stock }}</dd>
            <dt class="col-sm-4">Prix unitaire</dt><dd class="col-sm-8">{{ item.unitPrice }} DT</dd>
            <dt class="col-sm-4">Fournisseur</dt><dd class="col-sm-8">{{ item.supplier ?: '—' }}</dd>
            <dt class="col-sm-4">Seuil d’alerte</dt><dd class="col-sm-8">{{ item.alertThreshold }}</dd>
        </dl>
    </div>
{% endblock %}
