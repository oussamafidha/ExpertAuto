{% extends 'base.html.twig' %}{% block title %}{{ item.id ? 'Modifier une réparation' : 'Nouvelle réparation' }}{% endblock %}{% block body %}<h1 class="h2 fw-bold mb-4">{{ item.id ? 'Modifier une réparation' : 'Créer une réparation' }}</h1><div class="card p-4" style="max-width:850px"><form method="post"><div class="row g-3"><div class="col-md-6"><label class="form-label">Voiture</label><select class="form-select" name="vehicle" required><option value="">Choisir</option>{% for v in vehicles %}<option value="{{ v.id }}" {{ item.vehicle and item.vehicle.id == v.id ? 'selected' }}>{{ v.registrationNumber }} — {{ v.make }} {{ v.model }}</option>{% endfor %}</select></div><div class="col-md-6"><label class="form-label">Mécanicien</label><select class="form-select" name="mechanic"><option value="">Non affecté</option>{% for m in mechanics %}<option value="{{ m.id }}" {{ item.mechanic and item.mechanic.id == m.id ? 'selected' }}>{{ m.fullName }}</option>{% endfor %}</select></div><div class="col-md-6"><label class="form-label">Intervention</label><input class="form-control" name="title" value="{{ item.title }}" required></div><div class="col-md-6"><label class="form-label">Coût main-d'œuvre (DT)</label><input class="form-control" name="laborCost" type="number" min="0" step=".01" value="{{ item.laborCost }}"></div>{% if item.id %}<div class="col-md-6"><label class="form-label">État actuel</label><input class="form-control" value="{{ item.status }}" readonly></div>{% endif %}<div class="col-12"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="3">{{ item.description }}</textarea></div></div><button class="btn btn-primary mt-4">Enregistrer</button></form></div>{% endblock %}
