{% extends 'base.html.twig' %}

{% block title %}Rendez-vous du {{ item.appointmentAt|date('d/m/Y H:i') }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <h1 class="h2 fw-bold mb-0">Fiche rendez-vous</h1>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="{{ path('appointment_index') }}">Retour aux rendez-vous</a>
            {% if is_granted('ROLE_MECHANIC') %}
                <a class="btn btn-primary" href="{{ path('appointment_edit', {id: item.id}) }}">Modifier</a>
            {% endif %}
        </div>
    </div>
    <div class="card p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4">Date et heure</dt><dd class="col-sm-8">{{ item.appointmentAt|date('d/m/Y H:i') }}</dd>
            <dt class="col-sm-4">Voiture</dt><dd class="col-sm-8">{{ item.vehicle.registrationNumber }} — {{ item.vehicle.make }} {{ item.vehicle.model }}</dd>
            <dt class="col-sm-4">Client</dt><dd class="col-sm-8">{{ item.vehicle.ownerName }}</dd>
            <dt class="col-sm-4">Intervention</dt><dd class="col-sm-8">{{ item.service }}</dd>
            <dt class="col-sm-4">Mécanicien</dt><dd class="col-sm-8">{{ item.mechanic ? item.mechanic.fullName : 'Non affecté' }}</dd>
            <dt class="col-sm-4">Statut</dt><dd class="col-sm-8">{{ item.status }}</dd>
            <dt class="col-sm-4">Notes</dt><dd class="col-sm-8">{{ item.notes ?: '—' }}</dd>
        </dl>
    </div>
{% endblock %}
