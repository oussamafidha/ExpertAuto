{% extends 'base.html.twig' %}{% block title %}Pièces détachées{% endblock %}{% block body %}<div class="d-flex justify-content-between mb-4"><h1 class="h2 fw-bold">Pièces détachées</h1><a class="btn btn-primary" href="{{ path('part_new') }}">＋ Ajouter une pièce</a></div><div class="card p-4 table-responsive"><table class="table align-middle"><thead><tr><th>Référence</th><th>Pièce</th><th>Stock</th><th>Prix unitaire</th><th>Fournisseur</th><th>Alerte</th><th></th></tr></thead><tbody>{% for p in items %}<tr><td>{{ p.reference }}</td><td>{{ p.name }}</td><td>{{ p.stock }}</td><td>{{ p.unitPrice }} DT</td><td>{{ p.supplier ?: '—' }}</td><td>{% if p.stock <= p.alertThreshold %}<span class="badge text-bg-danger">Stock faible</span>{% else %}OK{% endif %}</td><td><a class="btn btn-sm btn-outline-primary" href="{{ path('part_show',{id:p.id}) }}">Consulter</a></td></tr>{% else %}<tr><td colspan="7">Aucune pièce.</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
