{% extends 'base.html.twig' %}{% block title %}Réparations{% endblock %}{% block body %}<div class="d-flex justify-content-between mb-4"><h1 class="h2 fw-bold">Réparations</h1><a class="btn btn-primary" href="{{ path('repair_new') }}">＋ Nouvelle réparation</a></div><div class="card p-4 table-responsive"><table class="table align-middle"><thead><tr><th>Date</th><th>Voiture</th><th>Intervention</th><th>Mécanicien</th><th>Statut</th><th>Main-d'œuvre</th><th></th></tr></thead><tbody>{% for r in items %}<tr><td>{{ r.openedAt|date('d/m/Y') }}</td><td>{{ r.vehicle.registrationNumber }} — {{ r.vehicle.make }} {{ r.vehicle.model }}</td><td>{{ r.title }}</td><td>{{ r.mechanic ? r.mechanic.fullName : 'Non affecté' }}</td><td>{{ r.status }}</td><td>{{ r.laborCost }} DT</td><td><a class="btn btn-sm btn-outline-primary" href="{{ path('repair_show',{id:r.id}) }}">Consulter</a></td></tr>{% else %}<tr><td colspan="7">Aucune réparation.</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
