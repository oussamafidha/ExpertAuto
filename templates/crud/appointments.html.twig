{% extends 'base.html.twig' %}{% block title %}Rendez-vous{% endblock %}{% block body %}<div class="d-flex justify-content-between mb-4"><h1 class="h2 fw-bold">Rendez-vous</h1><a class="btn btn-primary" href="{{ path('appointment_new') }}">＋ Nouveau rendez-vous</a></div><div class="card p-4 table-responsive"><table class="table align-middle"><thead><tr><th>Date / heure</th><th>Immatriculation</th><th>Voiture</th><th>Intervention</th><th>Mécanicien</th><th>Statut</th><th></th></tr></thead><tbody>{% for a in items %}<tr><td>{{ a.appointmentAt|date('d/m/Y H:i') }}</td><td>{{ a.vehicle.registrationNumber }}</td><td>{{ a.vehicle.make }} {{ a.vehicle.model }}</td><td>{{ a.service }}</td><td>{{ a.mechanic ? a.mechanic.fullName : 'Non affecté' }}</td><td>{{ a.status }}</td><td><a class="btn btn-sm btn-outline-primary" href="{{ path('appointment_show',{id:a.id}) }}">Consulter</a></td></tr>{% else %}<tr><td colspan="7">Aucun rendez-vous.</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
