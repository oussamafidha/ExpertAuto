{% extends 'base.html.twig' %}{% block title %}{{ item.id ? 'Modifier un rendez-vous' : 'Nouveau rendez-vous' }}{% endblock %}{% block body %}<h1 class="h2 fw-bold mb-4">{{ item.id ? 'Modifier un rendez-vous' : 'Prendre un rendez-vous' }}</h1><div class="card p-4" style="max-width:850px"><form method="post"><div class="row g-3"><div class="col-md-6"><label class="form-label">Voiture</label><select class="form-select" name="vehicle" required><option value="">Choisir une voiture</option>{% for v in vehicles %}<option value="{{ v.id }}" {{ item.vehicle and item.vehicle.id == v.id ? 'selected' }}>{{ v.registrationNumber }} — {{ v.make }} {{ v.model }} ({{ v.ownerName }})</option>{% endfor %}</select></div><div class="col-md-6"><label class="form-label">Date et heure</label><input class="form-control" type="datetime-local" name="appointmentAt" value="{{ item.appointmentAt|date('Y-m-d\\TH:i') }}" required></div><div class="col-md-6"><label class="form-label">Intervention prévue</label><input class="form-control" name="service" value="{{ item.service }}" required></div><div class="col-md-6"><label class="form-label">Mécanicien</label><select class="form-select" name="mechanic"><option value="">Non affecté</option>{% for m in mechanics %}<option value="{{ m.id }}" {{ item.mechanic and item.mechanic.id == m.id ? 'selected' }}>{{ m.fullName }}</option>{% endfor %}</select></div><div class="col-md-6"><label class="form-label">Statut</label><select class="form-select" name="status">{% for s in statuses %}<option {{ item.status == s ? 'selected' }}>{{ s }}</option>{% endfor %}</select></div><div class="col-12"><label class="form-label">Notes</label><textarea class="form-control" name="notes">{{ item.notes }}</textarea></div></div><button class="btn btn-primary mt-4">Enregistrer</button></form></div>{% endblock %}
